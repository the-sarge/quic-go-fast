+// TestSilentDropMsgSizeConnFidelity shows the message-size wrapper has exactly the
+// simnet endpoint's method set, so every interface the transport asserts on its
+// connection resolves the same way. WriteTo is the wrapper's own.
+func TestSilentDropMsgSizeConnFidelity(t *testing.T) {
+	methods := func(v any) []string {
+		typ := reflect.TypeOf(v)
+		names := make([]string, 0, typ.NumMethod())
+		for i := range typ.NumMethod() {
+			names = append(names, typ.Method(i).Name)
+		}
+		sort.Strings(names)
+		return names
+	}
+	require.Equal(t, methods(&simnet.SimConn{}), methods(&silentDropMsgSizeConn{}))
+}
