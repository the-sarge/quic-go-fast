+// installHooks composes the release and the variant in each endpoint's eligible-PTO
+// hook. Both run on that endpoint's connection goroutine inside its loss-timer call,
+// before the connection builds and hands off that expiration's probes.
+func (r *silentDropRun) installHooks(releaseAt int) {
 	r.client.onEligible = func(count int) {
-		if count == releaseAt && !r.released.Load() {
+		if releaseAt != 0 && count == releaseAt && !r.released.Load() {
 			r.released.Store(true)
 			r.capture.record("release", map[string]any{
 				"endpoint": "client", "at_eligible_count": count,
 				"received_first_packet": r.client.conn.receivedFirstPacket,
 			})
 		}
+		r.applyVariant(r.client, count)
+	}
+	r.server.onEligible = func(count int) { r.applyVariant(r.server, count) }
+}
+
+// applyVariant is the experimental trigger. lowerUnsetInitialPacketSize stays the sole
+// owner of the reduction and keeps its unset, pre-confirmation and above-1200 guards.
+func (r *silentDropRun) applyVariant(e *silentDropEndpoint, count int) {
+	v := r.variant
+	if v.threshold == 0 {
+		return
 	}
+	c := e.conn
+	fields := e.state("policy decision")
+	fields["variant"] = v.name
+	fields["eligible_count"] = count
+	switch {
+	case count < v.threshold:
+		fields["decision"] = "below_threshold"
+	case v.guard && c.receivedFirstPacket:
+		fields["decision"] = "guard_abstains"
+	default:
+		before := c.effectiveInitialPacketSize
+		c.lowerUnsetInitialPacketSize()
+		fields["decision"] = "trigger"
+		fields["reduced"] = c.effectiveInitialPacketSize < before
+		fields["effective_initial_packet_size_after"] = c.effectiveInitialPacketSize
+		fields["max_packet_size_after"] = c.maxPacketSize()
+		fields["max_payload_size_estimate_after"] = c.maxPayloadSizeEstimate.Load()
+	}
+	r.capture.record("policy", fields)
 }
 
