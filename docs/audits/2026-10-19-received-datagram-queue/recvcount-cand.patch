@@ -0,0 +1,13 @@
+package quic
+
+import "sync/atomic"
+
+// Measurement-only receive drop counters for #824's receiver builds; never
+// merged. The same counters and reader as #743's recvcount.patch.
+var debugDatagramQueueDrops, debugUnprocessedDrops atomic.Uint64
+
+// DebugReceiveDropsV743 reports drops at the received-DATAGRAM queue and the
+// unprocessed-packet queue since process start.
+func DebugReceiveDropsV743() (datagramQueue, unprocessed uint64) {
+	return debugDatagramQueueDrops.Load(), debugUnprocessedDrops.Load()
+}
