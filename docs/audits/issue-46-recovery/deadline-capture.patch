+package self_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go"
+	"github.com/quic-go/quic-go/internal/wire"
+	"github.com/quic-go/quic-go/qlog"
+	"github.com/quic-go/quic-go/qlogwriter"
+	"github.com/quic-go/quic-go/qlogwriter/jsontext"
+	"github.com/quic-go/quic-go/testutils/events"
+)
+
+// Temporary issue-46 instrumentation, retained only as an audit patch.
+type issue46Diagnostic struct {
+	start   time.Time
+	mu      sync.Mutex
+	records []any
+	order   uint64
+}
+
+func newIssue46Diagnostic(t *testing.T) *issue46Diagnostic {
+	d := &issue46Diagnostic{start: time.Now()}
+	t.Cleanup(func() {
+		d.mu.Lock()
+		defer d.mu.Unlock()
+		f, err := os.Create(os.Getenv("ISSUE46_OUTPUT"))
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer f.Close()
+		enc := json.NewEncoder(f)
+		for _, r := range d.records {
+			if err := enc.Encode(r); err != nil {
+				t.Error(err)
+				return
+			}
+		}
+	})
+	return d
+}
+
+func (d *issue46Diagnostic) record(kind string, data any) {
+	at := time.Since(d.start).Nanoseconds()
+	d.mu.Lock()
+	d.records = append(d.records, map[string]any{"ns": at, "kind": kind, "data": data})
+	d.mu.Unlock()
+}
+
+func (d *issue46Diagnostic) datagram(dir string, from, to string, b []byte) map[string]any {
+	d.mu.Lock()
+	d.order++
+	order := d.order
+	d.mu.Unlock()
+	parts := []any{}
+	remaining := b
+	for len(remaining) > 0 {
+		if !wire.IsLongHeaderPacket(remaining[0]) {
+			parts = append(parts, map[string]any{"type": "short", "length": len(remaining)})
+			break
+		}
+		hdr, packet, rest, err := wire.ParsePacket(remaining)
+		if err != nil {
+			parts = append(parts, map[string]any{"parse_error": err.Error()})
+			break
+		}
+		parts = append(parts, map[string]any{"type": fmt.Sprint(hdr.Type), "length": len(packet)})
+		if len(rest) >= len(remaining) {
+			break
+		}
+		remaining = rest
+	}
+	return map[string]any{"order": order, "direction": dir, "from": from, "to": to, "length": len(b), "crc_before": qlog.CalculateDatagramPayloadChecksum(b), "parts": parts, "callback_ns": time.Since(d.start).Nanoseconds(), "selected": false}
+}
+
+func (d *issue46Diagnostic) tracer(_ context.Context, client bool, id quic.ConnectionID) qlogwriter.Trace {
+	return &events.Trace{Recorder: &issue46Recorder{d: d, source: fmt.Sprintf("connection client=%t id=%s", client, id)}}
+}
+
+type issue46Recorder struct {
+	d      *issue46Diagnostic
+	source string
+}
+
+func (r *issue46Recorder) RecordEvent(e qlogwriter.Event) {
+	at := time.Since(r.d.start).Nanoseconds()
+	var buf bytes.Buffer
+	err := e.Encode(jsontext.NewEncoder(&buf), r.d.start)
+	data := map[string]any{"source": r.source, "event": e.Name(), "event_ns": at, "json": buf.String()}
+	if err != nil {
+		data["encode_error"] = err.Error()
+	}
+	r.d.record("qlog", data)
+}
+func (*issue46Recorder) Close() error { return nil }
+
+func errString46(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
+
+type issue46PacketConn struct {
+	net.PacketConn
+	d      *issue46Diagnostic
+	source string
+}
+
+func (c *issue46PacketConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	crc := qlog.CalculateDatagramPayloadChecksum(b)
+	at := time.Since(c.d.start).Nanoseconds()
+	n, err := c.PacketConn.WriteTo(b, addr)
+	c.d.record("socket_write", map[string]any{"source": c.source, "crc": crc, "length": len(b), "n": n, "error": errString46(err), "start_ns": at})
+	return n, err
+}
+func (c *issue46PacketConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(b)
+	c.d.record("socket_read", map[string]any{"source": c.source, "crc": qlog.CalculateDatagramPayloadChecksum(b[:n]), "n": n, "error": errString46(err)})
+	return n, addr, err
+}
