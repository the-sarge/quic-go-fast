diff --git 1/diagnostic_317.go 2/diagnostic_317.go
new file mode 100644
index 00000000..81989cc2
--- /dev/null
+++ 2/diagnostic_317.go
@@ -0,0 +1,37 @@
+package quic
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"runtime/debug"
+	"sync/atomic"
+)
+
+var diagnostic317Counter atomic.Uint64
+
+func diagnostic317Socket(t *Transport) string {
+	// Avoid adding LocalAddr calls to mocked PacketConns.
+	if c, ok := t.Conn.(*net.UDPConn); ok {
+		return c.LocalAddr().String()
+	}
+	return fmt.Sprintf("unavailable:%T", t.Conn)
+}
+
+func diagnostic317Event(t *Transport, event string, origin bool) {
+	completed := false
+	select {
+	case <-t.listening:
+		completed = true
+	default:
+	}
+	stack := []byte(nil)
+	if origin {
+		stack = debug.Stack()
+	}
+	fmt.Fprintf(os.Stderr, "[DEBUG-317] event=%s id=%d transport=%p socket=%s owned=%t completed=%t\n%s", event, t.diagnostic317ID, t, diagnostic317Socket(t), t.createdConn, completed, stack)
+}
+
+func diagnostic317Test(name, socket, event string) {
+	fmt.Fprintf(os.Stderr, "[DEBUG-317] test=%s socket=%s event=%s\n", name, socket, event)
+}
