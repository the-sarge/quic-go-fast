+
+func prototypeKey(level protocol.EncryptionLevel, pn protocol.PacketNumber) PrototypePacketKey {
+	return PrototypePacketKey{Space: level, Number: pn}
+}
+
+func TestIssue961PrototypePrefixes(t *testing.T) {
+	for _, path := range []bool{false, true} {
+		for _, before := range []bool{false, true} {
+			name := "ack_only"
+			if path {
+				name = "path_probe"
+			}
+			if before {
+				name += "_before_frontier"
+			} else {
+				name += "_after_frontier"
+			}
+			t.Run(name, func(t *testing.T) {
+				c := newTestCubicSender(false).sender
+				now := monotime.Time(time.Second)
+				excluded := prototypeKey(protocol.Encryption1RTT, 0)
+				eligible := prototypeKey(protocol.EncryptionHandshake, 0)
+				sendExcluded := func() {
+					c.PrototypeSent(now, 0, excluded, 1200, path, path)
+					t.Log("excluded registration:", c.PrototypeSnapshot())
+				}
+				if before {
+					sendExcluded()
+				}
+				c.PrototypeSent(now, 0, eligible, 1200, true, false)
+				t.Log("eligible registration:", c.PrototypeSnapshot())
+				if !before {
+					sendExcluded()
+				}
+				c.PrototypeCongestion(eligible, 1200, 1200)
+				t.Log("accepted cutback:", c.PrototypeSnapshot())
+				require.False(t, c.InRecovery(), "preserve no-prior-ACK reporting")
+				require.Equal(t, !before, c.prototypeCutback.after(excluded))
+				cut := c.prototypeCutback
+				window := c.GetCongestionWindow()
+				c.PrototypeCongestion(eligible, 1200, 1200)
+				t.Log("suppressed old loss:", c.PrototypeSnapshot())
+				require.Equal(t, cut, c.prototypeCutback)
+				require.Equal(t, window, c.GetCongestionWindow())
+				c.PrototypeAcked(eligible, 1200, 0, now)
+				require.True(t, c.InRecovery())
+				c.PrototypeSent(now, 0, prototypeKey(protocol.EncryptionInitial, 0), 1200, true, false)
+				c.PrototypeAcked(prototypeKey(protocol.EncryptionInitial, 0), 1200, 0, now)
+				t.Log("new-space post-cutback ACK:", c.PrototypeSnapshot())
+				require.False(t, c.InRecovery())
+				c.PrototypeAcked(eligible, 1200, 0, now)
+				require.False(t, c.InRecovery(), "old ACK cannot reactivate recovery")
+			})
+		}
+	}
+	t.Run("zero_and_one_rtt_share_identity", func(t *testing.T) {
+		var p prototypePrefix
+		p.note(prototypeKey(protocol.Encryption0RTT, 3))
+		require.False(t, p.after(prototypeKey(protocol.Encryption1RTT, 3)))
+		require.True(t, p.after(prototypeKey(protocol.Encryption1RTT, 4)))
+		t.Log("shared application prefix:", p)
+	})
+}
+
+func TestIssue961PrototypeSlowStart(t *testing.T) {
+	c := newTestCubicSender(false).sender
+	now := monotime.Time(time.Second)
+	for i := range 8 {
+		c.PrototypeSent(now, 0, prototypeKey(protocol.EncryptionHandshake, protocol.PacketNumber(i)), 1200, true, false)
+		if i == 3 {
+			c.PrototypeSent(now, 0, prototypeKey(protocol.Encryption1RTT, 0), 1200, true, false)
+		}
+	}
+	c.PrototypeSent(now, 0, prototypeKey(protocol.Encryption1RTT, 1), 1200, true, false)
+	s := &c.hybridSlowStart
+	for i := range 8 {
+		require.False(t, s.ShouldExitSlowStart(66*time.Millisecond, 60*time.Millisecond, 32))
+		c.PrototypeAcked(prototypeKey(protocol.EncryptionHandshake, protocol.PacketNumber(i)), 1200, 0, now)
+		t.Logf("pre-frontier Handshake/%d: %s", i, c.PrototypeSnapshot())
+		require.True(t, s.Started())
+		require.Equal(t, uint32(i+1), s.rttSampleCount)
+	}
+	c.PrototypeSent(now, 0, prototypeKey(protocol.Encryption1RTT, 2), 1200, true, false)
+	c.PrototypeAcked(prototypeKey(protocol.Encryption1RTT, 2), 1200, 0, now)
+	t.Log("strictly post-frontier application ACK:", c.PrototypeSnapshot())
+	require.False(t, s.Started())
+	require.False(t, s.ShouldExitSlowStart(66*time.Millisecond, 60*time.Millisecond, 32))
+	require.Equal(t, uint32(1), s.rttSampleCount)
+}
