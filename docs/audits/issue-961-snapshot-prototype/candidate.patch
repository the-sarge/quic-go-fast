+	"fmt"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+type PrototypePacketKey struct {
+	Space  protocol.EncryptionLevel
+	Number protocol.PacketNumber
+}
+
+type PrototypeSpaceSender interface {
+	PrototypeSent(monotime.Time, protocol.ByteCount, PrototypePacketKey, protocol.ByteCount, bool, bool)
+	PrototypeAcked(PrototypePacketKey, protocol.ByteCount, protocol.ByteCount, monotime.Time)
+	PrototypeCongestion(PrototypePacketKey, protocol.ByteCount, protocol.ByteCount)
+}
+
+// A prefix contains all registrations up to one instant, not three independently
+// chosen eligible sends. An absent space has no registrations in that prefix.
+type prototypePrefix struct {
+	numbers [3]protocol.PacketNumber
+	present uint8
+}
+
+func prototypeSpace(level protocol.EncryptionLevel) int {
+	switch level {
+	case protocol.EncryptionInitial:
+		return 0
+	case protocol.EncryptionHandshake:
+		return 1
+	case protocol.Encryption0RTT, protocol.Encryption1RTT:
+		return 2
+	default:
+		panic("invalid prototype space")
+	}
+}
+
+func (p *prototypePrefix) note(key PrototypePacketKey) {
+	i := prototypeSpace(key.Space)
+	p.numbers[i] = key.Number
+	p.present |= 1 << i
+}
+
+func (p prototypePrefix) after(key PrototypePacketKey) bool {
+	i := prototypeSpace(key.Space)
+	return p.present&(1<<i) == 0 || key.Number > p.numbers[i]
+}
+
+func (p prototypePrefix) String() string {
+	return fmt.Sprintf("%v/mask=%03b", p.numbers, p.present)
+}
+
+func (c *cubicSender) PrototypeSent(now monotime.Time, flight protocol.ByteCount, key PrototypePacketKey, size protocol.ByteCount, ackEliciting, pathProbe bool) {
+	c.prototypeRegistered.note(key)
+	if pathProbe {
+		return // no pacing, flight, or eligible-frontier change for this path
+	}
+	c.pacer.SentPacket(now, size)
+	if !ackEliciting {
+		return
+	}
+	c.prototypeEligible = c.prototypeRegistered
+	c.hybridSlowStart.prototypeAware = true
+	c.hybridSlowStart.prototypeLatest = c.prototypeEligible
+	c.hybridSlowStart.OnPacketSent(key.Number)
+}
+
+func (c *cubicSender) PrototypeAcked(key PrototypePacketKey, bytes, flight protocol.ByteCount, now monotime.Time) {
+	c.prototypeHasACK = true
+	if c.prototypeHasCutback && c.prototypeCutback.after(key) {
+		c.prototypeRecovering = false
+	}
+	if c.InRecovery() {
+		return
+	}
+	c.maybeIncreaseCwnd(key.Number, bytes, flight, now)
+	if c.InSlowStart() && c.hybridSlowStart.prototypeRound.after(key) {
+		c.hybridSlowStart.started = false
+	}
+}
+
+func (c *cubicSender) PrototypeSnapshot() string {
+	return fmt.Sprintf("registered=%s eligible=%s cutback=%s hasCutback=%t hasACK=%t active=%t recovery=%t cwnd=%d hystartRound=%s samples=%d", c.prototypeRegistered, c.prototypeEligible, c.prototypeCutback, c.prototypeHasCutback, c.prototypeHasACK, c.prototypeRecovering, c.InRecovery(), c.congestionWindow, c.hybridSlowStart.prototypeRound, c.hybridSlowStart.rttSampleCount)
+}
