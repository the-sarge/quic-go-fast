@@ -0,0 +1,223 @@
+package ackhandler
+
+// THROWAWAY handler traces. The ECN path uses the real tracker throughout.
+
+import (
+	"fmt"
+	"testing"
+	"time"
+	"unsafe"
+
+	"github.com/quic-go/quic-go/internal/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"github.com/quic-go/quic-go/internal/wire"
+	"github.com/stretchr/testify/require"
+)
+
+func newPrototypeHandler(ecn bool, perspective protocol.Perspective) *sentPacketHandler {
+	h := NewSentPacketHandler(0, 1200, utils.NewRTTStats(), &utils.ConnectionStats{}, true, ecn, nil, perspective, nil, utils.DefaultLogger).(*sentPacketHandler)
+	// Fix only this fixture's application skip schedule. A separate trace tests skipping.
+	h.appDataPackets.pns = newSequentialPacketNumberGenerator(0)
+	return h
+}
+
+func prototypeSend(t *testing.T, h *sentPacketHandler, at monotime.Time, level protocol.EncryptionLevel, ack, mtu, path bool) protocol.PacketNumber {
+	t.Helper()
+	pn := h.PopPacketNumber(level)
+	var frames []Frame
+	if ack {
+		frames = []Frame{{Frame: &wire.PingFrame{}}}
+	}
+	mark := protocol.ECNNon
+	if h.enableECN && level == protocol.Encryption1RTT && !path {
+		mark = h.ECNMode(true)
+	}
+	h.SentPacket(at, pn, protocol.InvalidPacketNumber, nil, frames, level, mark, 1200, mtu, path)
+	t.Logf("send %s/%d ack=%t mtu=%t path=%t: %s", level, pn, ack, mtu, path, h.congestion.(interface{ PrototypeSnapshot() string }).PrototypeSnapshot())
+	return pn
+}
+
+func prototypeACK(t *testing.T, h *sentPacketHandler, at monotime.Time, level protocol.EncryptionLevel, first, last protocol.PacketNumber, ect, ce uint64) {
+	t.Helper()
+	_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: []wire.AckRange{{Smallest: first, Largest: last}}, ECT0: ect, ECNCE: ce}, level, at)
+	require.NoError(t, err)
+	t.Logf("ACK %s/%d-%d ECT0=%d CE=%d: %s", level, first, last, ect, ce, h.congestion.(interface{ PrototypeSnapshot() string }).PrototypeSnapshot())
+}
+
+func prototypeHandshakeCut(t *testing.T, h *sentPacketHandler, at monotime.Time) {
+	t.Helper()
+	for range 4 {
+		prototypeSend(t, h, at, protocol.EncryptionHandshake, true, false, false)
+	}
+	prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.EncryptionHandshake, 1, 3, 0, 0)
+}
+
+func prototypeCapable(t *testing.T) (*sentPacketHandler, monotime.Time) {
+	t.Helper()
+	h := newPrototypeHandler(true, protocol.PerspectiveServer)
+	at := monotime.Time(time.Second)
+	for range 10 {
+		prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+	}
+	prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.Encryption1RTT, 0, 9, 10, 0)
+	require.Equal(t, ecnStateCapable, h.ecnTracker.(*ecnTracker).state)
+	return h, at.Add(30 * time.Millisecond)
+}
+
+func TestIssue961PrototypeECNMissingAnchor(t *testing.T) {
+	for _, before := range []bool{false, true} {
+		for _, retired := range []bool{false, true} {
+			t.Run(fmt.Sprintf("before=%t/retired=%t", before, retired), func(t *testing.T) {
+				h, at := prototypeCapable(t)
+				if !before {
+					prototypeHandshakeCut(t, h, at)
+					at = at.Add(30 * time.Millisecond)
+				}
+				lower := prototypeSend(t, h, at, protocol.Encryption1RTT, false, false, false)
+				anchor := prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+				require.Equal(t, protocol.PacketNumber(10), lower)
+				require.Equal(t, protocol.PacketNumber(11), anchor)
+				if before {
+					prototypeHandshakeCut(t, h, at)
+					at = at.Add(30 * time.Millisecond)
+				}
+				if retired {
+					require.True(t, h.QueueProbePacketAt(protocol.Encryption1RTT, at))
+				}
+				var foundLower, foundAnchor bool
+				for pn := range h.appDataPackets.history.Packets() {
+					foundLower = foundLower || pn == lower
+					foundAnchor = foundAnchor || pn == anchor
+				}
+				require.True(t, foundLower)
+				require.Equal(t, !retired, foundAnchor)
+				require.Equal(t, protocol.PacketNumber(9), h.appDataPackets.largestAcked)
+				window := h.congestion.GetCongestionWindow()
+				prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.Encryption1RTT, lower, anchor, 11, 1)
+				want := window
+				if !before {
+					want = window * 7 / 10
+				}
+				require.Equal(t, want, h.congestion.GetCongestionWindow())
+				tracker := h.ecnTracker.(*ecnTracker)
+				require.Equal(t, ecnStateCapable, tracker.state)
+				require.Equal(t, int64(1), tracker.numAckedECNCE)
+				require.Equal(t, int64(11), tracker.numAckedECT0)
+				prototypeACK(t, h, at.Add(21*time.Millisecond), protocol.Encryption1RTT, lower, anchor, 11, 1)
+				prototypeACK(t, h, at.Add(22*time.Millisecond), protocol.Encryption1RTT, 0, 8, 8, 0)
+				require.Equal(t, want, h.congestion.GetCongestionWindow(), "duplicate/reordered ACK cannot cut again")
+			})
+		}
+	}
+}
+
+func TestIssue961PrototypeMixedCEAndLoss(t *testing.T) {
+	h, at := prototypeCapable(t)
+	for range 4 {
+		prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+	}
+	before := h.congestion.GetCongestionWindow()
+	prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.Encryption1RTT, 13, 13, 10, 1)
+	require.Equal(t, before*7/10, h.congestion.GetCongestionWindow())
+	require.Equal(t, ecnStateCapable, h.ecnTracker.(*ecnTracker).state)
+}
+
+func TestIssue961PrototypeHandshakeApplication(t *testing.T) {
+	h := newPrototypeHandler(false, protocol.PerspectiveServer)
+	at := monotime.Time(time.Second)
+	for range 7 {
+		prototypeSend(t, h, at, protocol.EncryptionHandshake, true, false, false)
+	}
+	prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+	prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.EncryptionHandshake, 6, 6, 0, 0)
+	require.Equal(t, protocol.ByteCount(26880), h.congestion.GetCongestionWindow())
+	require.True(t, h.congestion.InRecovery())
+	prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption1RTT, true, false, false)
+	prototypeACK(t, h, at.Add(50*time.Millisecond), protocol.Encryption1RTT, 1, 1, 0, 0)
+	require.False(t, h.congestion.InRecovery())
+	for range 4 {
+		prototypeSend(t, h, at.Add(60*time.Millisecond), protocol.Encryption1RTT, true, false, false)
+	}
+	prototypeACK(t, h, at.Add(80*time.Millisecond), protocol.Encryption1RTT, 3, 5, 0, 0)
+	require.Equal(t, protocol.ByteCount(18816), h.congestion.GetCongestionWindow())
+}
+
+func TestIssue961PrototypeLifecycle(t *testing.T) {
+	t.Run("Retry_and_zero_to_one_rtt", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveClient)
+		at := monotime.Time(time.Second)
+		prototypeSend(t, h, at, protocol.EncryptionInitial, true, false, false)
+		prototypeSend(t, h, at, protocol.Encryption0RTT, true, false, false)
+		h.ResetForRetry(at.Add(20 * time.Millisecond))
+		require.Equal(t, protocol.PacketNumber(1), prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.EncryptionInitial, true, false, false))
+		require.Equal(t, protocol.PacketNumber(1), prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption0RTT, true, false, false))
+		h.DropPackets(protocol.Encryption0RTT, at.Add(40*time.Millisecond))
+		h.DropPackets(protocol.EncryptionInitial, at.Add(40*time.Millisecond))
+		require.Equal(t, protocol.PacketNumber(2), prototypeSend(t, h, at.Add(50*time.Millisecond), protocol.Encryption1RTT, true, false, false))
+		prototypeACK(t, h, at.Add(70*time.Millisecond), protocol.Encryption1RTT, 2, 2, 0, 0)
+		require.False(t, h.congestion.InRecovery())
+	})
+	t.Run("migration_keeps_wire_numbers_resets_controller", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveClient)
+		at := monotime.Time(time.Second)
+		prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+		h.MigratedPath(at.Add(20*time.Millisecond), 1200)
+		require.Equal(t, protocol.ByteCount(38400), h.congestion.GetCongestionWindow())
+		require.Equal(t, protocol.PacketNumber(1), prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption1RTT, true, false, false))
+		prototypeACK(t, h, at.Add(50*time.Millisecond), protocol.Encryption1RTT, 1, 1, 0, 0)
+		require.False(t, h.congestion.InRecovery())
+	})
+	t.Run("intentional_skip_remains_validated", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveServer)
+		h.appDataPackets.pns = newSkippingPacketNumberGenerator(0, 256, 1024)
+		h.appDataPackets.pns.(*skippingPacketNumberGenerator).nextToSkip = 2
+		at := monotime.Time(time.Second)
+		for _, want := range []protocol.PacketNumber{0, 1, 3} {
+			require.Equal(t, want, prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false))
+		}
+		_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: []wire.AckRange{{Smallest: 0, Largest: 3}}}, protocol.Encryption1RTT, at.Add(20*time.Millisecond))
+		require.ErrorContains(t, err, "skipped packet number")
+		prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.Encryption1RTT, 3, 3, 0, 0)
+		require.Zero(t, h.connStats.PacketsLost.Load(), "skipped number cannot count toward threshold")
+	})
+	t.Run("MTU_loss_excluded", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveServer)
+		at := monotime.Time(time.Second)
+		window := h.congestion.GetCongestionWindow()
+		prototypeSend(t, h, at, protocol.Encryption1RTT, true, true, false)
+		for range 3 {
+			prototypeSend(t, h, at, protocol.Encryption1RTT, true, false, false)
+		}
+		prototypeACK(t, h, at.Add(20*time.Millisecond), protocol.Encryption1RTT, 3, 3, 0, 0)
+		require.Equal(t, window, h.congestion.GetCongestionWindow())
+		require.Zero(t, h.connStats.PacketsLost.Load())
+		require.False(t, h.congestion.InRecovery())
+	})
+	t.Run("MTU_ACK_crosses", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveServer)
+		at := monotime.Time(time.Second)
+		prototypeHandshakeCut(t, h, at)
+		window := h.congestion.GetCongestionWindow()
+		pn := prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption1RTT, true, true, false)
+		prototypeACK(t, h, at.Add(50*time.Millisecond), protocol.Encryption1RTT, pn, pn, 0, 0)
+		require.False(t, h.congestion.InRecovery())
+		require.Equal(t, window, h.congestion.GetCongestionWindow())
+	})
+	t.Run("path_probe_and_ACK_only_do_not_exit_recovery", func(t *testing.T) {
+		h := newPrototypeHandler(false, protocol.PerspectiveServer)
+		at := monotime.Time(time.Second)
+		prototypeHandshakeCut(t, h, at)
+		lower := prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption1RTT, false, false, false)
+		upper := prototypeSend(t, h, at.Add(30*time.Millisecond), protocol.Encryption1RTT, true, false, true)
+		prototypeACK(t, h, at.Add(50*time.Millisecond), protocol.Encryption1RTT, lower, upper, 0, 0)
+		require.True(t, h.congestion.InRecovery())
+	})
+}
+
+func TestIssue961PrototypeLayout(t *testing.T) {
+	c := congestion.NewCubicSender(congestion.DefaultClock{}, utils.NewRTTStats(), &utils.ConnectionStats{}, 1200, true, nil)
+	t.Logf("packet=%d cubicSender=%d HybridSlowStart=%d bytes", unsafe.Sizeof(packet{}), unsafe.Sizeof(*c), unsafe.Sizeof(congestion.HybridSlowStart{}))
+	require.Equal(t, uintptr(80), unsafe.Sizeof(packet{}))
+}
