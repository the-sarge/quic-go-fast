#!/bin/bash
set -euo pipefail

# Validate the index in isolation: partially staged files and local module
# replacements must not make the checks read or rewrite the working tree.
root=$(git rev-parse --show-toplevel)
cd "$root"
snapshot=$(mktemp -d)
trap 'rm -rf -- "$snapshot"' EXIT
mkdir "$snapshot/tree"
if ! git checkout-index --all --prefix="$snapshot/tree/"; then
  echo "Could not check out the staged files" >&2
  exit 1
fi
if ! git diff --cached --name-only --diff-filter=ACMRT -z -- '*.go' > "$snapshot/changed-go"; then
  echo "Could not list staged Go files" >&2
  exit 1
fi

files=()
while IFS= read -r -d '' file; do
  # core.symlinks=false materializes symlink blobs as regular files. Git's
  # staged mode, rather than the checkout alone, owns the input type.
  entry=$(git --literal-pathspecs ls-files --stage -- "$file")
  mode=${entry%% *}
  if [[ ( "$mode" != 100644 && "$mode" != 100755 ) || -L "$snapshot/tree/$file" || ! -f "$snapshot/tree/$file" ]]; then
    printf 'Staged Go input must be a regular file: %q\n' "$file" >&2
    exit 1
  fi
  files+=("./$file")
done < "$snapshot/changed-go"

cd "$snapshot/tree"
if [[ ${#files[@]} -gt 0 ]]; then
  if ! output=$(gofumpt -d "${files[@]}"); then
    echo "gofumpt failed while checking staged Go files" >&2
    printf '%s\n' "$output" >&2
    exit 1
  fi
  if [[ -n "$output" ]]; then
    echo "Staged Go files are not properly gofumpt-ed" >&2
    printf '%s\n' "$output" >&2
    exit 1
  fi
fi

# The vendor fixture's ../../ replacement now points at the staged root.
# Disable workspace discovery so a caller's go.work cannot redirect this check.
if ! (cd integrationtests/gomodvendor && GOWORK=off go mod tidy -diff); then
  echo "Module validation failed for staged integrationtests/gomodvendor" >&2
  exit 1
fi
